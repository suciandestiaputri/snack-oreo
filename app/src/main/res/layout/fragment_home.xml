<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Logo SITOSA -->
    <ImageView
        android:id="@+id/ivLogoSawit"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_sitosa"
        android:contentDescription="Logo SITOSA"
        app:layout_constraintBottom_toTopOf="@+id/tvAppTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Judul Aplikasi Sesuai Grand Design -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SITOSA"
        android:textColor="#1C290D"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/originalsurfer_regular"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/tvAppSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogoSawit" />

    <!-- Subtitle Aplikasi -->
    <TextView
        android:id="@+id/tvAppSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sistem Informasi Toke Sawit"
        android:textColor="#676F53"
        android:textSize="14sp"
        android:fontFamily="@font/originalsurfer_regular"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/btnMyProject"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppTitle" />

    <!-- Tombol 1: My Project -->
    <Button
        android:id="@+id/btnMyProject"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#005B94"
        android:text="MY PROJECT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="100dp"
        app:layout_constraintBottom_toTopOf="@+id/btnInfoSawit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppSubtitle" />

    <!-- Tombol 2: Info Toke Sawit -->
    <Button
        android:id="@+id/btnInfoSawit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1C290D"
        android:text="INFO TOKE SAWIT"
        android:textColor="#FEFAE0"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="@font/originalsurfer_regular"
        app:cornerRadius="100dp"
        app:layout_constraintBottom_toTopOf="@+id/btnProfileDev"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMyProject" />

    <!-- Tombol 3: Profil Developer (BARU) -->
    <Button
        android:id="@+id/btnProfileDev"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1C290D"
        android:text="PROFIL DEVELOPER"
        android:textColor="#FEFAE0"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="@font/originalsurfer_regular"
        app:cornerRadius="100dp"
        app:layout_constraintBottom_toTopOf="@+id/btnLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnInfoSawit" />

    <!-- Tombol 4: Logout (BARU) -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#C0392B"
        android:text="LOGOUT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnProfileDev" />

</androidx.constraintlayout.widget.ConstraintLayout>